# Abluo Sandbox — the ONLY Supabase project tests, rehearsals and seed
# scripts may write to (ADR-038 D8). Copy to .env.sandbox.local (git-ignored)
# and fill in from Supabase → Abluo Sandbox → Project Settings → API.
# Never put the production project's values here; the guards refuse them.
NEXT_PUBLIC_SUPABASE_URL=https://<sandbox-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
