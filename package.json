    "probe:live:staging": "node scripts/probe-live.mjs --staging",
    "verify:dashboard": "playwright test",
    "verify:connections": "vitest run --config vitest.live.config.ts",
    "verify:i18n": "playwright test --project=i18n-desktop --project=i18n-phone",
