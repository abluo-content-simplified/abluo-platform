  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "routes:generate": "node scripts/generate-route-config.mjs",
    "routes:check": "node scripts/generate-route-config.mjs --check",
