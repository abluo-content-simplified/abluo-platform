# dependencies
node_modules/
# next.js
.next/
out/
# environment variables
.env
.env.local
.env*.local
# typescript
*.tsbuildinfo
# macOS
.DS_Store
# Sanity Studio build artifacts
dist/static/*.json
# vercel
.vercel/

# FUSE mount artifacts — the sandbox mount cannot unlink() open files, so an
# edited file can leave a .fuse_hidden* behind that nothing is able to remove.
# Untracked and inert; ignored so it can never be committed by `git add -A`.
.fuse_hidden*

# Local safety copies: Sanity dataset exports and pre-migration document
# snapshots. Real content, sometimes large, never part of a build.
backups/
